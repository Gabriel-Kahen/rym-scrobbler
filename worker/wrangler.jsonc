{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rym-scrobbler",
  "main": "src/index.js",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 40, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
